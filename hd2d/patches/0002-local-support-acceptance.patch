+// ponytail: visible FAR extension only; no hidden-background or depth-layer truth.
+// Four rings, four axis taps maximum. Search only toward the visible center side.
+vec4 local_far_support(ivec2 hole, vec2 center, float center_coc, float reach) {
+	ivec2 source_size = textureSize(color_texture, 0);
+	vec2 toward_center = center - vec2(hole);
+	int previous = 0;
+	for (int level = 0; level < 4; level++) {
+		int distance = min(1 << level, int(reach));
+		if (distance <= previous) { continue; }
+		previous = distance;
+		vec3 rgb = vec3(0.0);
+		float count = 0.0;
+		for (int axis = 0; axis < 4; axis++) {
+			ivec2 offset = axis == 0 ? ivec2(distance, 0) : (axis == 1 ? ivec2(-distance, 0) : (axis == 2 ? ivec2(0, distance) : ivec2(0, -distance)));
+			if (dot(vec2(offset), toward_center) <= 0.0) { continue; }
+			ivec2 donor_pos = hole + offset;
+			if (any(lessThan(donor_pos, ivec2(0))) || any(greaterThanEqual(donor_pos, source_size))) { continue; }
+			vec4 donor = texelFetch(color_texture, donor_pos, 0);
+			if (donor.a > 0.0 && donor.a >= center_coc) { rgb += donor.rgb; count += 1.0; }
+		}
+		if (count > 0.0) { return vec4(rgb / count, 1.0); }
+	}
+	return vec4(0.0);
+}
 
